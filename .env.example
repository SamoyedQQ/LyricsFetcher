# 複製本檔為 .env 後填入實際值：  cp .env.example .env
# ⚠ .env 含有金鑰，已列入 .gitignore，請勿提交到版本控制

# ── 必填 ─────────────────────────────────────────────
# Notion Integration 的 Internal Integration Secret（通常以 ntn_ 或 secret_ 開頭）
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 目標資料庫 ID：可貼 32 碼 ID、帶連字號的 UUID，或直接貼整個資料庫網址
DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 選填：欄位名稱（未填則自動比對常見名稱）─────────────
# 歌名一律寫入資料庫的「標題」欄位，不需設定
# NOTION_ARTIST_PROPERTY=Artist     # 型別：Text / Select / Multi-select
# NOTION_LYRICS_PROPERTY=Lyrics     # 型別：Text
# NOTION_URL_PROPERTY=URL           # 型別：URL

# ── 選填：自訂 CSS selector（內建規則抓不到時使用）────────
# TITLE_SELECTOR=h1.song-title
# ARTIST_SELECTOR=.song-artist a
# LYRICS_SELECTOR=#lyrics-body

# ── 選填：Notion API 版本（預設 2022-06-28，一般不需更改）──
# NOTION_VERSION=2022-06-28
