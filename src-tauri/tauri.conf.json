{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyrics Fetcher",
  "version": "0.2.1",
  "identifier": "app.lyricsfetcher.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lyrics Fetcher",
        "width": 1320,
        "height": 900,
        "minWidth": 480,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0c0d10",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
